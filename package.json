{
  "name": "draw.io",
  "version": "32.7.4-av.0",
  "description": "draw.io desktop",
  "exports": "./src/main/electron.js",
  "type": "module",
  "main": "src/main/electron.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prestart": "node ./sync-plugins.cjs",
    "start": "electron .",
    "sync": "node ./sync.cjs",
    "sync-plugins": "node ./sync-plugins.cjs",
    "build-win": "node ./sync.cjs && node ./sync-plugins.cjs && electron-builder --config electron-builder-av.json --win --dir --publish never",
    "dist-win": "node ./sync.cjs && node ./sync-plugins.cjs && electron-builder --config electron-builder-av.json --win nsis zip --x64 --publish never",
    "test": "node --test \"src/test/*.test.js\"",
    "release-linux": "electron-builder --config electron-builder-linux-mac.json --publish always",
    "release-snap": "electron-builder --config electron-builder-snap.json --publish never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jacinlowe/drawio-AV-desktop.git"
  },
  "keywords": [
    "draw.io",
    "diagram",
    "flowchart",
    "UML"
  ],
  "author": "JGraph <support@draw.io>",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/jgraph/drawio-desktop/issues"
  },
  "homepage": "https://github.com/jgraph/drawio",
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.3",
    "buffer": "^6.0.3",
    "compression": "^1.8.1",
    "crc": "^4.3.2",
    "electron-context-menu": "^5.1.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.1",
    "dotenv": "^17.4.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.7",
    "quicklookjs": "^1.0.1",
    "sumchecker": "^3.0.1"
  }
}
